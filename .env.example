# # ==============================================================================
# # Mentor AI English - Environment Configuration Template
# # Copy this file to '.env' and fill in the values before running the application.
# # ==============================================================================

# # Application Profile & Port
# SPRING_PROFILES_ACTIVE=dev
# SERVER_PORT=8081

# # PostgreSQL Database Configuration
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mentor_ai_english
# DB_USERNAME=postgres
# DB_PASSWORD=your_secure_db_password

# # Redis Configuration (Used for production session storage and distributed cache)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password_if_any

# # OpenAI Integration Configuration
# # Obtain your key from https://platform.openai.com/
# OPENAI_API_KEY=your-openai-api-key-here

# # Security Settings
# # Generate a secure key for signing tokens / cookies or sessions
# JWT_SECRET=your-super-secret-jwt-signing-key-at-least-256-bits-long
# SESSION_TIMEOUT=30m
